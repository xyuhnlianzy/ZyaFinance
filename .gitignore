# ZyaFinance .gitignore — Clean repo, no secrets, no junk

# Environment & secrets
.env
.env.*
*.env
*.env.local
*.env.*.local
config.yaml
config.yml
secrets.*
*.pem
*.key
*.crt

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS / System
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Build
node_modules/
dist/
build/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.pytest_cache/

# Local data / user content
money.txt
*.sqlite
*.db
*.db-*
localStorage-*.json
sessionStorage-*.json

# Cache / temp
.cache/
.tmp/
temp/
*.cache

# Hermes / Local agent state (if present)
.hermes/*.db
.hermes/*.db-*
.hermes/*.log
.hermes/*.pid
.hermes/*.lock
.hermes/*.json
!.hermes/config.yaml.example

# Android / Mobile build (if using Capacitor/PWA Builder later)
android/
ios/
capacitor.config.json

# Misc
*.apk
*.aab
*.ipa
*.zip
*.tar.gz
*.backup
*.bak

# Keep these tracked
!zyafinance.html
!manifest.json
!sw.js
!.gitignore